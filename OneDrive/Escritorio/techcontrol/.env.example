# Copia este archivo como .env y cambia los valores:  cp .env.example .env

# Puerto del servidor Ubuntu donde se abrirá la app (http://IP-DEL-SERVIDOR:8080)
APP_PORT=8080

# URL con la que los equipos de la red abren la app (IP real del servidor)
FRONTEND_URL=http://192.168.1.50:8080

# --- Base de datos (MySQL en Docker) ---
DB_NAME=techcontrol
DB_USER=techcontrol
DB_PASSWORD=cambia_esta_contrasena
DB_ROOT_PASSWORD=cambia_esta_contrasena_root

# --- Seguridad ---
# Genera cada uno con:  openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
# Clave de 32 bytes en base64 (contraseñas Wi-Fi y de equipos). Genera con:  openssl rand -base64 32
# ¡No la cambies después de guardar contraseñas o ya no se podrán descifrar!
NETWORK_SECRET_KEY=

# La red local usa http (sin https): debe quedar en false o el login no guarda la sesión
COOKIE_SECURE=false

# El backend está detrás de Nginx: así ve la IP real de cada usuario (límite de intentos de login)
TRUST_PROXY=1

# --- Usuario administrador inicial (solo para "npm run seed" si la BD no trae usuarios) ---
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@techcontrol.local
SEED_ADMIN_PASSWORD=cambia_esta_contrasena
